# Copy this file to .env and fill in the values you have.
# Do not commit .env.

# Required only for Tushare data workflows.
TUSHARE_TOKEN=

# Required only for iWencai semantic report/search workflows.
IWENCAI_API_KEY=
IWENCAI_BASE_URL=https://openapi.iwencai.com

# Optional throttling for Eastmoney requests, in seconds.
EASTMONEY_MIN_INTERVAL=1.5

# Generic provider keys used by the phase-one adapters.
MARKET_DATA_API_KEY=
DISCLOSURE_API_KEY=
NEWS_API_KEY=
INDUSTRY_API_KEY=

# Local database and generated report paths.
DB_PATH=data/a_share_review.db
DAILY_MD_DIR=data/daily
DAILY_JSON_DIR=data/json
