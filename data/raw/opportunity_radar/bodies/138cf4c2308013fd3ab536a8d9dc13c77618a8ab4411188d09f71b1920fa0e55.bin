<tr>
<td style="vertical-align: middle; text-align: left; padding-left: 20.0px;" role="rowheader"><em>Free cash flow margin %</em></td>
<td style="vertical-align: bottom;">&nbsp;</td>
<td style="border-top: double black 3pt; padding-right: 0; text-align: right; vertical-align: middle;">&nbsp;</td>
<td style="border-top: double black 3pt; padding-left: 0; padding-right: 0; text-align: right; vertical-align: middle;"><em>25</em></td>
<td style="border-top: double black 3pt; padding-left: 0; text-align: left; vertical-align: middle;"><em>%</em></td>
<td style="vertical-align: bottom;">&nbsp;</td>
<td style="border-top: double black 3pt; padding-right: 0; text-align: right; vertical-align: middle;">&nbsp;</td>
<td style="border-top: double black 3pt; padding-left: 0; padding-right: 0; text-align: right; vertical-align: middle;"><em>20</em></td>
