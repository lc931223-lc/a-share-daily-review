<td colspan="1" style="max-width: 15%; width: 15%; min-width: 15%; ;border-top: solid black 1pt; border-bottom: solid black 1pt; border-left: solid black 1pt; text-align: center; vertical-align: middle; border-right: solid black 1pt;" role="columnheader"><strong>Q1'25</strong></td>
<td style="max-width: 15%; width: 15%; min-width: 15%; ;border-top: solid black 1pt; border-bottom: solid black 1pt; border-left: solid black 1pt; text-align: center; vertical-align: middle; border-right: solid black 1pt;" role="columnheader"><strong>Y/Y</strong></td>
<td colspan="1" style="max-width: 15%; width: 15%; min-width: 15%; ;border-top: solid black 1pt; border-bottom: solid black 1pt; border-left: solid black 1pt; text-align: center; vertical-align: middle; border-right: solid black 1pt;" role="columnheader"><strong>Q4'25</strong></td>
<td style="max-width: 15%; width: 15%; min-width: 15%; ;border-top: solid black 1pt; border-bottom: solid black 1pt; border-left: solid black 1pt; text-align: center; vertical-align: middle; border-right: solid black 1pt;" role="columnheader"><strong>Q/Q</strong></td>
