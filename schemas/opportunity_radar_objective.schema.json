          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "signal_type": {
                "const": "COMMODITY_PRICE"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "instrument",
                  "category",
                  "latest_value",
                  "unit",
                  "currency",
                  "change_1d",
                  "change_3d",
                  "change_5d",
                  "change_10d",
                  "change_20d",
                  "percentile_20d",
                  "percentile_60d",
                  "percentile_250d",
                  "new_high_20d",
                  "new_high_60d",
                  "new_low_20d",
                  "slope_3d",
                  "slope_10d",
                  "slope_20d",
                  "acceleration_3d_vs_20d",
                  "historical_volatility"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "signal_type": {
                "const": "SUPPLY_DEMAND"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "metric",
                  "industry",
                  "current_value",
                  "previous_value",
                  "change_abs",
                  "change_pct",
                  "percentile",
                  "zscore",
                  "trend_5d",
                  "trend_20d"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "signal_type": {
                "const": "CAPACITY_AND_UTILIZATION"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "industry",
                  "company",
                  "metric",
                  "current",
                  "previous",
                  "delta",
                  "historical_percentile",
                  "event_type",
                  "announced_capacity",
                  "effective_capacity"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "signal_type": {
                "const": "POLICY_AND_FISCAL"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "title",
                  "publisher",
                  "affected_industries",
                  "affected_regions",
                  "policy_stage",
                  "fiscal_amount",
                  "project_amount",
                  "implementation_date"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "signal_type": {
                "const": "TECHNOLOGY_BREAKTHROUGH"
              }
            }
          },
          "then": {
            "properties": {
              "facts": {
                "required": [
                  "technology",
                  "institution",
                  "company",
                  "milestone_type",
                  "previous_stage",
                  "current_stage",
