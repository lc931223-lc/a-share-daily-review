{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["date", "run_id", "is_trade_day", "market_closed", "pipeline_started_at", "pipeline_completed_at", "steps", "status", "blockers", "readiness_checks"],
  "properties": {
    "date": {"type": "string", "format": "date"},
    "run_id": {"type": "string"},
    "is_trade_day": {"type": "boolean"},
    "market_closed": {"type": "boolean"},
    "pipeline_started_at": {"type": "string"},
    "pipeline_completed_at": {"type": "string"},
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "artifact_path", "source_date", "quality", "started_at", "completed_at", "error", "retry_count"]
      }
    },
    "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAILED", "NON_TRADING_DAY", "MARKET_NOT_CLOSED"]},
    "blockers": {"type": "array"},
    "readiness_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
