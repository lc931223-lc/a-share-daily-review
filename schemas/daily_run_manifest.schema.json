{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["date", "run_id", "is_trade_day", "market_closed", "pipeline_started_at", "pipeline_completed_at", "steps", "status", "blockers", "readiness_checks", "failed_step", "blocker", "credential_health", "retry_count", "source_health", "upstream_available", "upstream_missing", "started_at", "completed_at"],
  "properties": {
    "failed_step": {"type": ["string", "null"]},
    "blocker": {"type": "array"},
    "retry_count": {"type": "integer", "minimum": 0},
    "source_health": {"type": "object"},
    "upstream_available": {"type": "array", "items": {"type": "string"}},
    "upstream_missing": {"type": "array", "items": {"type": "string"}},
    "started_at": {"type": "string"},
    "completed_at": {"type": "string"},
    "date": {"type": "string", "format": "date"},
    "run_id": {"type": "string"},
    "is_trade_day": {"type": ["boolean", "null"]},
    "credential_health": {"type": "object", "required": ["tushare_token"], "additionalProperties": false, "properties": {"tushare_token": {"enum": ["AVAILABLE", "MISSING"]}}},
    "market_closed": {"type": "boolean"},
    "pipeline_started_at": {"type": "string"},
    "pipeline_completed_at": {"type": "string"},
    "steps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "artifact_path", "source_date", "quality", "started_at", "completed_at", "error", "retry_count"]
      }
    },
    "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAILED", "NON_TRADING_DAY", "MARKET_NOT_CLOSED"]},
    "blockers": {"type": "array"},
    "readiness_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "detail"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"},
          "detail": {"type": "string"}
        }
      }
    }
  }
}
