          "type": "string"
        },
        "quality": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL"
          ],
          "title": "Quality",
          "type": "string"
        },
        "is_cached": {
          "default": false,
          "title": "Is Cached",
          "type": "boolean"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        }
      },
      "required": [
        "source",
        "retrieved_at",
        "freshness",
        "quality"
      ],
      "title": "SourceMeta",
      "type": "object"
    }
