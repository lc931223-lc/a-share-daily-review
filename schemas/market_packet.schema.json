{
  "$defs": {
    "DataQuality": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "EXCELLENT",
            "GOOD",
            "PARTIAL",
            "INCOMPLETE"
          ],
          "title": "Status",
          "type": "string"
        },
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/QualityCheck"
          },
          "title": "Checks",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceMeta"
          },
          "title": "Sources",
          "type": "array"
        },
        "conflicts": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Conflicts",
          "type": "array"
        }
      },
      "required": [
        "status",
        "score",
        "checks",
        "sources"
      ],
      "title": "DataQuality",
      "type": "object"
    },
    "PacketMeta": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "market_packet.1",
          "title": "Schema Version",
          "type": "string"
        },
        "trade_date": {
          "format": "date",
          "title": "Trade Date",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "generated_by": {
          "const": "codex_market_packet_phase1",
          "title": "Generated By",
          "type": "string"
        },
        "codex_role": {
          "const": "data_engineer_data_validator_research_clerk",
          "title": "Codex Role",
          "type": "string"
        },
        "final_judgement_owner": {
          "const": "chatgpt",
          "title": "Final Judgement Owner",
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "trade_date",
        "generated_at",
        "generated_by",
        "codex_role",
        "final_judgement_owner"
      ],
      "title": "PacketMeta",
      "type": "object"
    },
    "QualityCheck": {
      "additionalProperties": false,
      "properties": {
        "item": {
          "title": "Item",
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "PARTIAL",
            "FAIL"
          ],
          "title": "Status",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "item",
        "status",
        "detail"
      ],
      "title": "QualityCheck",
      "type": "object"
    },
    "SourceMeta": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "title": "Source",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "data_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
